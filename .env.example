# ========================================================
# Wedding Photo Delivery Platform - Environment Configuration
# ========================================================

# Django Core
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=localhost,127.0.0.1,photos.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://photos.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://photos.yourdomain.com

# PostgreSQL Database
POSTGRES_DB=wedding_platform
POSTGRES_USER=wedding_user
POSTGRES_PASSWORD=wedding_secure_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# Storage Mounts (inside containers)
MEDIA_ROOT=/media
# Host folder path for persistent photo storage on server/laptop
HOST_MEDIA_PATH=./media_data

# ========================================================
# Coolify S3 / MinIO Private Storage (4-5 TB SSD Setup)
# ========================================================
# Physical path to your 4-5 TB SSD mounted on your Ubuntu laptop (e.g. /mnt/storage or /media/ssd)
HOST_STORAGE_PATH=/mnt/storage

# MinIO Root Credentials
MINIO_ROOT_USER=wedding_minio_admin
MINIO_ROOT_PASSWORD=wedding_minio_secure_password

# Public & Internal S3 Endpoints
# Internal container network endpoint for Django backend:
S3_ENDPOINT_URL=http://minio:9000
# Public HTTPS URL called directly by client browsers for uploads/downloads:
S3_PUBLIC_URL=https://s3.yourdomain.com
S3_ACCESS_KEY_ID=wedding_minio_admin
S3_SECRET_ACCESS_KEY=wedding_minio_secure_password
S3_BUCKET_NAME=wedding-storage
S3_REGION=us-east-1

# Coolify FQDN Domain Mappings (Managed by Coolify Traefik)
SERVICE_FQDN_APP=https://photos.yourdomain.com
SERVICE_FQDN_MINIO=https://s3.yourdomain.com
SERVICE_FQDN_MINIO_CONSOLE=https://console.yourdomain.com

# Initial Admin User (auto-created on first container startup if not exists)
ADMIN_NAME="Studio Admin"
ADMIN_EMAIL=admin@weddingstudio.com
ADMIN_PASSWORD=AdminSecurePassword123!

# SMTP Email Configuration (free tier provider like Brevo, Resend, or SendGrid)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@weddingstudio.com
EMAIL_HOST_PASSWORD=app-specific-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Wedding Studio <notifications@weddingstudio.com>"
REPLY_TO_EMAIL=contact@weddingstudio.com

# Optional Cloudflare Turnstile CAPTCHA (leave blank to bypass in local dev)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Gateway Port (HTTP port for the nginx gateway container on host)
GATEWAY_PORT=80
