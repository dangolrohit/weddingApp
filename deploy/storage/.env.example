# deploy/storage/.env.example
# Environment variables for Garage S3 private wedding storage

# 1. Garage Admin & RPC Secrets (generate on Ubuntu server)
# openssl rand -hex 32
GARAGE_RPC_SECRET=your_32_byte_hex_rpc_secret_here
# openssl rand -hex 16
GARAGE_ADMIN_TOKEN=your_16_byte_hex_admin_token_here

# 2. Garage S3 API Access Credentials
# Generated via: garage key create wedding-app-key
GARAGE_S3_ACCESS_KEY_ID=GKxxxxxxxxxxxxxxxxxxxxxx
GARAGE_S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Bucket and Endpoints
GARAGE_S3_BUCKET_NAME=wedding-storage
GARAGE_S3_REGION=garage

# Backend internal connection (inside server network or localhost)
GARAGE_S3_ENDPOINT_URL=http://127.0.0.1:3900

# Public HTTPS URL accessed by client browsers for direct uploads/downloads
GARAGE_S3_PUBLIC_URL=https://cloud.abcd.com

# 4. Storage SSD Mount Paths (Persistently mounted by UUID in /etc/fstab)
# SSD 1 Mount Point: /mnt/ssd1/garage-data (e.g. UUID=11111111-2222-3333-4444-555555555555)
# SSD 2 Mount Point: /mnt/ssd2/garage-data (e.g. UUID=66666666-7777-8888-9999-aaaaaaaaaaaa)
# Metadata Path on Internal NVMe: /var/lib/garage/meta
